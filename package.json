{
  "name": "telegram-football-prediction-bot",
  "version": "1.0.0",
  "description": "Advanced Telegram bot for football match analysis using Gemini AI and The-Odds-API",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "ts-node index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "test": "node --test 'scripts/test/*.test.mjs'",
    "schedina": "node scripts/generate.mjs",
    "schedina:mock": "node scripts/generate.mjs --mock --out preview/data"
  },
  "keywords": [
    "telegram",
    "bot",
    "football",
    "predictions",
    "gemini",
    "ai",
    "odds-api",
    "supabase"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.0.3",
    "telegraf": "^4.12.0",
    "axios": "^1.4.0",
    "@supabase/supabase-js": "^2.31.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "@types/node": "^20.3.1",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/telegram-football-bot.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/telegram-football-bot/issues"
  },
  "homepage": "https://github.com/your-username/telegram-football-bot#readme"
}
