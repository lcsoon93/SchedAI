COPIA TUTTO QUESTO CONTENUTO E INCOLLALO IN: .env.example

================================================================================

# ========================================
# BOT TELEGRAM - CONFIGURATION FILE
# ========================================
# IMPORTANTE: NON CONDIVIDERE QUESTO FILE!
# Salva solo su server/hosting, mai su GitHub
# ========================================

# TELEGRAM BOT
# Ottenere da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# THE-ODDS-API
# Registrati su theoddsapi.com
# Tier gratuito: 500 requests/mese
THE_ODDS_API_KEY=your_odds_api_key_here

# GEMINI AI API
# Registrati su https://aistudio.google.com
# Copia API Key dalla console
GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE DATABASE
# Crea progetto su supabase.com
# Copia credenziali da Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ENVIRONMENT
# Valori: development, production
NODE_ENV=production

# DEBUG MODE (opzionale)
# Valori: true, false
DEBUG=false

# ========================================
# COME OTTENERE LE CREDENZIALI
# ========================================

# TELEGRAM_BOT_TOKEN:
# 1. Apri Telegram e cerca @BotFather
# 2. Digita /newbot
# 3. Segui le istruzioni
# 4. Copia il token ricevuto

# THE_ODDS_API_KEY:
# 1. Va su theoddsapi.com
# 2. Registrati (account gratuito)
# 3. Dashboard > API Keys
# 4. Copia la chiave

# GEMINI_API_KEY:
# 1. Va su https://aistudio.google.com
# 2. Accedi con Google
# 3. Create API Key
# 4. Copia e salva

# SUPABASE_URL e SUPABASE_KEY:
# 1. Va su supabase.com
# 2. Crea nuovo progetto
# 3. Settings > API
# 4. Copia Project URL e anon/public key

# ========================================
# SICUREZZA
# ========================================
# RICORDA:
# - Mai mettere questo file su GitHub
# - Aggiungi .env a .gitignore
# - Usa variabili d'ambiente sul server
# - Ruota chiavi periodicamente
# - Monitora utilizzo API quotidiano
# ========================================

================================================================================
